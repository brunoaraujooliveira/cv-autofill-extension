{
  "name": "cv-autofill-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that fills job application forms from a structured resume.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:mentions": "node scripts/check-mentions.mjs",
    "test:e2e": "tsc --noEmit && npm run build:e2e && playwright test",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e && vite build --config test/fixtures/vite.config.ts"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "author": "Bruno Araújo de Oliveira",
  "engines": {
    "node": ">=22.12"
  }
}
